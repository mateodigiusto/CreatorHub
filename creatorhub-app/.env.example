# CreatorHub — environment variables.
#
# Cloud-only setup. We don't run Supabase locally; everything points at
# your cloud project at https://<your-ref>.supabase.co.
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Never commit .env.local. Find every value in Supabase dashboard →
# Project Settings → (API + Database).

# ─── Database (pgbouncer + direct) ────────────────────────────────
# Project Settings → Database → Connection string → "Transaction pooler".
# App code uses this. Port is 6543. We require ?pgbouncer=true (the dashboard
# usually adds it for you) and `prepare: false` on the postgres-js driver.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Same screen, "Direct connection" — port 5432. Used by drizzle-kit
# migrations and the migration round-trip test (DDL inspection). Never
# used by the app at runtime.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase (Auth + Storage + Vault) ────────────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set after creating a Vault secret in the Supabase dashboard
# (Project Settings → Vault). Used by the encryption layer to look up
# the active KEK without ever exposing it to the app server.
SUPABASE_VAULT_KEY_ID=

# ─── Schema version assertion ────────────────────────────────────
# Set by CI from the highest migration number. instrumentation.ts asserts
# this matches max(schema_migrations.version) at boot. Mismatch = refuse to
# serve traffic in production. In local dev you can leave it unset and the
# check is skipped.
EXPECTED_SCHEMA_VERSION=30

# ─── Auth feature flags ───────────────────────────────────────────
# Hides the "Continue with Google" button on /login until you've added
# Google OAuth credentials in Supabase Dashboard → Auth → Providers →
# Google. Magic-link sign-in works regardless. Flip to "true" only after
# the provider is configured + the OAuth consent screen is published.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# ─── Sentry (Phase 1) ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Cloudflare Stream (Phase 1) ──────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ─── Cron worker auth ─────────────────────────────────────────────
# Shared secret. Vercel Cron sends this in the Authorization header
# (Bearer <secret>); /api/cron/* routes 401 without it. Generate a random
# 48+ char string. In Vercel, set the same value under Settings → Cron Jobs.
CRON_SECRET=

# ─── Encryption ───────────────────────────────────────────────────
# Bootstrap secret authorizing the server to call Supabase Vault. NOT the
# encryption key itself — KEK lives in Vault, accessed by SUPABASE_VAULT_KEY_ID.
ENCRYPTION_KEY=

# ─── Stripe (subscriptions) ───────────────────────────────────────
# All optional — when STRIPE_SECRET_KEY is empty, the onboarding paywall
# falls back to its UI-only mock (writes profile.trial to localStorage +
# DB but doesn't take payment). Fill these once Products + Prices exist
# in your Stripe dashboard.
#   1. Stripe Dashboard → Products: create "CreatorHub Standard" + "CreatorHub Pro".
#   2. Each product → 2 prices: monthly + annual. Note the 4 price IDs.
#   3. Webhooks: add endpoint https://<your-domain>/api/webhooks/stripe,
#      events: checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted. Note the signing secret.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Public-facing canonical URL for Checkout return URLs. Defaults to the
# request's origin when unset; set explicitly in prod for safety.
APP_URL=

# ─── Content DNA real-AI pipeline ─────────────────────────────────
# All three keys must be set together for POST /api/content-dna to switch
# from the deterministic stub into the real pipeline (Apify scrape →
# OpenAI Whisper transcribe → Claude Sonnet 4.6 analyze). Missing any one
# of them keeps the stub fallback active so dev / preview keep working.
#
# Cost shape (per analysis): Apify ~$0.01–0.05 + Whisper $0.006/min +
# Claude ~$0.04. Standard tier caps at 15 analyses/month per user; Pro
# tier (active or trialing subscription with plan='pro') is uncapped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APIFY_API_TOKEN=

# ─── App URL (used by email templates for deep links) ────────────
# Set to your production canonical URL. In Vercel previews, leave unset
# and templates fall back to https://creatorhub.app.
NEXT_PUBLIC_APP_URL=

# ─── Transactional email (Resend) ─────────────────────────────────
# Wire after signing up at resend.com (free tier covers 3k emails/mo).
# DNS verification of the sending domain is required before emails will
# actually deliver. When either var is unset, the email path is a no-op
# (in-app notifications still fire) so the deploy doesn't break before
# you finish setup.
#
# EMAIL_FROM must match a verified domain on your Resend account, e.g.
# `CreatorHub <noreply@creatorhub.app>`.
RESEND_API_KEY=
EMAIL_FROM=

# ─── Admin allowlist ──────────────────────────────────────────────
# Comma-separated list of email addresses that can access /admin/*
# (currently: /admin/creators for the directory CRUD + bulk CSV import).
# Match is case-insensitive on the email of the signed-in user.
# Leave unset in dev to grant access to all signed-in users for testing.
ADMIN_EMAILS=

# ─── Product analytics (PostHog or compatible) ────────────────────
# Lightweight no-SDK shim in src/lib/analytics/track.ts. When the key
# is unset, every track() call is a no-op so dev/preview deploys don't
# emit events. Compatible with PostHog Cloud, self-hosted PostHog, or
# any Mixpanel-style ingestor that accepts the
# {api_key, event, distinct_id, properties} JSON shape.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Phase 2: Meta / Instagram ────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ─── Phase 3+: other platforms ────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
