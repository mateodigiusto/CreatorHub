# CreatorHub — environment variables.
#
# Cloud-only setup. We don't run Supabase locally; everything points at
# your cloud project at https://<your-ref>.supabase.co.
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Never commit .env.local. Find every value in Supabase dashboard →
# Project Settings → (API + Database).

# ─── Database (pgbouncer + direct) ────────────────────────────────
# Project Settings → Database → Connection string → "Transaction pooler".
# App code uses this. Port is 6543. We require ?pgbouncer=true (the dashboard
# usually adds it for you) and `prepare: false` on the postgres-js driver.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Same screen, "Direct connection" — port 5432. Used by drizzle-kit
# migrations and the migration round-trip test (DDL inspection). Never
# used by the app at runtime.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase (Auth + Storage + Vault) ────────────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set after creating a Vault secret in the Supabase dashboard
# (Project Settings → Vault). Used by the encryption layer to look up
# the active KEK without ever exposing it to the app server.
SUPABASE_VAULT_KEY_ID=

# ─── Schema version assertion ────────────────────────────────────
# Set by CI from the highest migration number. instrumentation.ts asserts
# this matches max(schema_migrations.version) at boot. Mismatch = refuse to
# serve traffic in production. In local dev you can leave it unset and the
# check is skipped.
EXPECTED_SCHEMA_VERSION=13

# ─── Auth feature flags ───────────────────────────────────────────
# Hides the "Continue with Google" button on /login until you've added
# Google OAuth credentials in Supabase Dashboard → Auth → Providers →
# Google. Magic-link sign-in works regardless. Flip to "true" only after
# the provider is configured + the OAuth consent screen is published.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# ─── Sentry (Phase 1) ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Cloudflare Stream (Phase 1) ──────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ─── Cron worker auth ─────────────────────────────────────────────
# Shared secret. Vercel Cron sends this in the Authorization header
# (Bearer <secret>); /api/cron/* routes 401 without it. Generate a random
# 48+ char string. In Vercel, set the same value under Settings → Cron Jobs.
CRON_SECRET=

# ─── Encryption ───────────────────────────────────────────────────
# Bootstrap secret authorizing the server to call Supabase Vault. NOT the
# encryption key itself — KEK lives in Vault, accessed by SUPABASE_VAULT_KEY_ID.
ENCRYPTION_KEY=

# ─── Phase 2: Meta / Instagram ────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ─── Phase 3+: other platforms ────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
