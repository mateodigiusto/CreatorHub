{
  "name": "creatorhub-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:link": "supabase link",
    "db:migrate": "supabase db push --linked",
    "db:reset": "supabase db reset --linked",
    "db:status": "supabase migration list --linked",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "schema:version": "node -e \"const m=require('fs').readdirSync('supabase/migrations').filter(f=>f.endsWith('.sql')).sort(); console.log(m.length)\"",
    "test": "vitest",
    "test:rls": "vitest run tests/rls.spec.ts",
    "test:rls:relationships": "vitest run tests/rls-relationships.spec.ts",
    "test:migration": "vitest run tests/migration-roundtrip.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^8",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/ssr": "^0.5",
    "@supabase/supabase-js": "^2.45",
    "apify-client": "^2.23.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "postgres": "^3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.28",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "supabase": "^1.200",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1"
  }
}
