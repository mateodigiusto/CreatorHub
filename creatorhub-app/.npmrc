# Use legacy peer dependency resolution.
#
# Why: @sentry/nextjs (and occasionally others) ship conservative
# `peerDependencies` ranges that lag behind newer Next.js majors. The SDKs
# work fine on Next 16 for the surface we use (captureException, beforeSend
# redaction, server/edge instrumentation), but strict resolution refuses
# to install. Setting this here means `npm install` Just Works for every
# contributor without --legacy-peer-deps in their muscle memory.
#
# Revisit when @sentry/nextjs ships a version with `next@^16` in its peers.
legacy-peer-deps=true
